# -----------------------------------------------------------------------------
# ESCAPADES PWA - VARIABLES D'ENVIRONNEMENT
# Note : Sur Vite, toutes les variables exposées au client doivent débuter par VITE_
# -----------------------------------------------------------------------------

# Clé API Mistral AI (Gratuite sur console.mistral.ai)
VITE_MISTRAL_API_KEY=votre_cle_api_mistral_ici

# Clé API Google Gemini (Gratuite sur aistudio.google.com)
VITE_GEMINI_API_KEY=votre_cle_api_gemini_ici

# Fournisseur AI par défaut (mistral | gemini | openai)
VITE_DEFAULT_LLM_PROVIDER=mistral
